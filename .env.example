# 复制为 .env 后按需修改。所有变量前缀 SKINTONE_。

# ── 认证（默认不启用） ────────────────────────────────────────────────
# 面向大众的入口不该要求密钥——那一步会把绝大多数用户挡在门外。
# 防滥用交给下面的「每日配额」。
# 想给自己上锁时（开发期 / 临时关站）才填一个足够长的随机值：
#   $rng=[System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $b=New-Object byte[] 24; $rng.GetBytes($b)
#   'sk_'+(($b|%{$_.ToString('x2')}) -join '')
SKINTONE_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────
# 逗号分隔。前端跑在 GitHub Pages 时，把 Pages 域名加进来。
# 开发阶段可以用 *，对外暴露时不建议。
SKINTONE_ALLOWED_ORIGINS=*

# ── 限流与体积 ────────────────────────────────────────────────────────
# 短时速率限制（令牌桶，按 IP）；配额之外的第二道闸。
SKINTONE_RATE_LIMIT=30/minute
SKINTONE_MAX_UPLOAD_MB=20

# ── 防滥用闸门（**不是认证**） ────────────────────────────────────────
# 刻意**不使用客户端 IP**：手机运营商 CGNAT 会让大量真实用户共用出口 IP，
# 按 IP 限流必然误伤（一个人测完，同网段另一个人就被挡）。以下每条都对真人零误伤。
# 设为 0 表示该条不限制。
#
# 单指纹（请求头 X-Client-Id）：每日次数 + 两次测量之间的冷却
SKINTONE_QUOTA_ENABLED=true
SKINTONE_QUOTA_PER_DAY_CLIENT=5
SKINTONE_QUOTA_COOLDOWN_SECONDS=15
# 全站天花板：无论对方怎么换指纹都撞得到
SKINTONE_QUOTA_GLOBAL_PER_DAY=200
# 全站每日上传字节预算（MB）——直接保护磁盘，这才是真正的风险
SKINTONE_QUOTA_GLOBAL_MB_PER_DAY=500
# 全站每分钟令牌桶（不依赖任何标识，给洪水限速）
SKINTONE_GLOBAL_RATE_LIMIT=120/minute
# 并发分析数上限；超出排队而不是把 CPU 打满
SKINTONE_MAX_CONCURRENT_ANALYSES=2
SKINTONE_QUEUE_WAIT_SECONDS=20
# 闸门库文件；留空则用 SKINTONE_DATA_DIR/guard.sqlite
SKINTONE_QUOTA_DB=

# ── 存储 ──────────────────────────────────────────────────────────────
SKINTONE_DATA_DIR=./data
SKINTONE_RETENTION_DAYS=30

# ── 监听 ──────────────────────────────────────────────────────────────
# 建议保持 127.0.0.1：对外只通过隧道出站，不开放入站端口。
SKINTONE_HOST=127.0.0.1
SKINTONE_PORT=8000
SKINTONE_LOG_LEVEL=INFO

# ── 隧道（供 scripts/tunnel.ps1 使用） ────────────────────────────────
SKINTONE_TUNNEL_NAME=skintone-api
SKINTONE_TUNNEL_HOSTNAME=skintest.0721.luxe
# 连接器 token 文件路径。默认取仓库上一级的 .cloudflared-token。
# 该文件含凭据，已在 .gitignore 中排除，绝不要提交。
SKINTONE_TUNNEL_TOKEN_FILE=..\.cloudflared-token
